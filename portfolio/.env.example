# Every environment variable the platform reads, with its default.
# Nothing is required: with no variables set, everything runs offline against
# the deterministic mock provider.
#
# The services do not load a .env file themselves. `docker compose` reads
# portfolio/.env and forwards only LLM_PROVIDER, LLM_BASE_URL, LLM_MODEL and
# GUARD_GROUNDING_THRESHOLD to the containers. For a local run, export the
# variables you change in your shell.

# --- model provider (shared/llm/providers.py) ---------------------------------
LLM_PROVIDER=mock                 # mock | ollama | openai-compatible
LLM_BASE_URL=                     # ollama default http://127.0.0.1:11434/v1; required for openai-compatible
LLM_MODEL=                        # ollama default llama3.2; openai-compatible default gpt-4o-mini
LLM_API_KEY=                      # only for an openai-compatible endpoint that needs one

# --- response cache (shared/llm/cache.py) -------------------------------------
CACHE_ENABLED=true                # GroundedCorp exact + semantic answer cache
LLM_CACHE_TTL=900                 # seconds an entry lives
LLM_CACHE_MAX=256                 # entries before eviction
LLM_CACHE_SIMILARITY=0.93         # cosine needed for a semantic cache hit

# --- guardrails (shared/guardrails, overrides policy.json) --------------------
GUARD_GROUNDING_THRESHOLD=0.35    # output blocked below this grounding score
GUARD_REDACT_PII=true             # redact email, phone, SSN, PAN, Aadhaar, IFSC and card numbers
GUARD_CHECK_SECRETS=true          # block and redact credentials
GUARD_CHECK_TOXICITY=true         # flag toxic text

# --- observability (shared/observability/core.py) -----------------------------
OTEL_MAX_SPANS=500                # spans kept in memory per service

# --- GroundedCorp retrieval (01-groundedcorp/app/config.py) -------------------
CHUNK_SIZE=220                    # words per chunk
CHUNK_OVERLAP=50                  # words shared by adjacent chunks
EMBED_DIM=256                     # hashing-embedding dimensions
TOP_K=4                           # passages returned per question
BM25_K1=1.5                       # term-frequency saturation
BM25_B=0.75                       # length normalisation
RRF_K=60                          # reciprocal rank fusion constant
MMR_LAMBDA=0.72                   # relevance vs diversity
CONTEXT_TOKEN_BUDGET=900          # cap on context sent to the model
RELATIVE_SCORE_FLOOR=0.65         # drop candidates below this share of the best
GROUNDING_THRESHOLD=0.30          # refuse below this grounding score
MIN_RERANK_SCORE=0.30             # refuse when no passage addresses the question
MIN_COVERAGE=0.28                 # refuse when query terms are absent from the corpus

# --- AgentForge (02-agentforge/app) -------------------------------------------
MAX_COST_UNITS=0.5                # budget per ticket; exceeding it escalates to a human
MAX_GRAPH_STEPS=24                # hard ceiling on graph steps per run

# --- container port (portfolio/Dockerfile) ------------------------------------
# Set per service by the Dockerfile's PORT build arg (8001, 8002, 8003). Locally,
# pass --port to uvicorn instead; nothing else reads it.
# PORT=8001
